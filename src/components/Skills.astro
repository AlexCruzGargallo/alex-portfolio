---
const skills = [
  "React",
  "TypeScript",
  "JavaScript",
  "HTML/CSS",
  "Tailwind",
  "Angular",
  "Astro",
];
---

<section id="skills" class="mx-auto max-w-6xl px-6 py-20">
  <h2 class="text-3xl font-bold">{"</> "}Habilidades Tecnicas</h2>

  <p class="mt-2 text-zinc-400">
    Tecnologias y herramientas con las que trabajo.
  </p>

  <div class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-4">
    {
      skills.map((skill) => (
        <div class="rounded-2xl border border-white/10 bg-zinc-900/30 p-6 text-center transition hover:border-white/30">
          {skill}
        </div>
      ))
    }
  </div>
</section>
